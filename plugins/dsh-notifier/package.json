{
  "name": "dsh-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "Generic in-app notifications: top toast + session-header bell with tray, provided as the notifier client service",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
