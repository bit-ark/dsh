{
  "name": "@bit-ark/dsh-plugmgr",
  "version": "0.1.0",
  "description": "已安装插件管理器：在设置-插件里提供「插件管理」tab，管理 profile 里本地目录 / npm / Git 来源安装的插件（列出/添加/按名称安装/移除/禁用/启用/更新）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
