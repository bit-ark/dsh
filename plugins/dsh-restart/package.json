{
  "name": "dsh-restart",
  "version": "0.1.0",
  "private": true,
  "description": "侧边栏一键重启 dsh web：两步确认后在原终端窗口重启服务（macOS Terminal.app）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
